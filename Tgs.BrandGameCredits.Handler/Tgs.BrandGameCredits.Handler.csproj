<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<UserSecretsId>1edca983-7d2d-4095-8240-07b27c0ddaf8</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<PropertyGroup>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<NoWarn>$(NoWarn);1591;0063</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Protos\gamewagerbrandscommon.proto" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.3.8" />
		<PackageReference Include="Grpc.AspNetCore" Version="2.62.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
		<PackageReference Include="Npgsql" Version="8.0.3" />
		<PackageReference Include="OpenTelemetry" Version="1.8.1" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.8.1" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.8.1" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.8.1" />
		<PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.0.0-beta.7" />
		<PackageReference Include="OpenTelemetry.Instrumentation.GrpcCore" Version="1.0.0-beta.5" />
		<PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.0.0-rc9.3" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.8.1" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.8.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.5" />
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.7" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.1" />
		<PackageReference Include="Tgs.Interceptors" Version="0.2.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tgs.BrandGameCredits.Handler.Common\Tgs.BrandGameCredits.Handler.Common.csproj" />
		<ProjectReference Include="..\Tgs.BrandGameCredits.Handler.Core\Tgs.BrandGameCredits.Handler.Core.csproj" />
		<ProjectReference Include="..\Tgs.BrandGameCredits.Handler.Repositories\Tgs.BrandGameCredits.Handler.Repositories.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\gamewagerbrandscommon.proto">
			<GrpcServices>None</GrpcServices>
		</Protobuf>
	</ItemGroup>

</Project>

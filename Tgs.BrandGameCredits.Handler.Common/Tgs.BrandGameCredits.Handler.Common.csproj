<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Protos\brandgamecreditshandlercommon.proto" />
	  <None Remove="Protos\gamewagerbrandscommon.proto" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.59.0" />
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="Protos\brandgamecreditshandlercommon.proto" GrpcServices="None" />
	  <Protobuf Include="Protos\gamewagerbrandscommon.proto" GrpcServices="None" />
	</ItemGroup>

</Project>
